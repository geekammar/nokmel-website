{
  "name": "nokmel-website",
  "version": "0.1.0",
  "private": true,
  "description": "Nokmel marketing website (nokmel.tech) — Next.js App Router, TypeScript, Tailwind CSS",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:check": "drizzle-kit check",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "owner:provision": "tsx scripts/provision-owner.ts",
    "owner:reset-password": "tsx scripts/provision-owner.ts --reset-password",
    "dev:postgres": "tsx scripts/dev-postgres.ts"
  },
  "dependencies": {
    "@fontsource-variable/alexandria": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "better-auth": "1.7.28",
    "drizzle-orm": "0.45.4",
    "next": "15.5.29",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.7.0",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.7.0-beta.19",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/linux-x64",
      "esbuild"
    ]
  }
}
