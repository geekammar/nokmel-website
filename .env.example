# Nokmel Website — environment contract (placeholders only; never commit real values)
#
# ---------------------------------------------------------------------------
# A. Deployed application runtime (Vercel "Production"/"Preview" only)
# ---------------------------------------------------------------------------
# Pooled runtime connection. Use the restricted runtime role; no DDL rights.
DATABASE_URL=postgresql://runtime-role:REPLACE_ME@ep-xxx-pooler.region.aws.neon.tech/nokmel_website?sslmode=require
BETTER_AUTH_SECRET=REPLACE_ME_MIN_32_RANDOM_CHARS
# Exact origin for the current environment. Preview deployments must use their
# own explicit preview origin; arbitrary *.vercel.app hosts are not trusted.
BETTER_AUTH_URL=https://nokmel.tech
# Exact authorized aliases (for example one immutable preview URL), comma-separated.
# No wildcards, paths, queries, fragments, or credentials.
TRUSTED_ORIGINS=https://nokmel.tech
OWNER_EMAIL=owner@REPLACE_ME.example
# Early-access join intake gate. Missing/invalid values keep intake disabled.
# Enabled intake also requires a valid BETTER_AUTH_SECRET (32+ chars) and valid
# exact BETTER_AUTH_URL/TRUSTED_ORIGINS; otherwise the API fails closed with 503.
# Enable only on the authorized isolated development Preview in W4; Production
# intake requires explicit owner authorization and approved privacy/retention.
JOIN_INTAKE_ENABLED=
# Public indexing release control. Leave unset (indexing disabled) until the
# owner-authorized launch step. Requires BOTH this flag and positive
# VERCEL_ENV=production identification. Preview, development, missing or
# unknown environment metadata always remain noindex/nofollow. Never set this
# in a Preview environment.
SITE_INDEXING_ENABLED=

# Test-only rate-limit override. Ignored unless NOKMEL_DISPOSABLE_TEST_ENV is 1,
# and always ignored when VERCEL_ENV is production/preview. Do not set these in
# any deployed environment.
RATE_LIMIT_SIGNIN_MAX=
JOIN_RATE_LIMIT_MAX=
NOKMEL_DISPOSABLE_TEST_ENV=

# ---------------------------------------------------------------------------
# B. Operator machine only — NEVER configure these in Vercel/deployed runtime
# ---------------------------------------------------------------------------
# Direct (non-pooled) migration/provisioning connection with the migrator role.
# Required by `pnpm db:migrate`, `pnpm owner:provision`, `pnpm owner:reset-password`.
# The application runtime never falls back to this value.
DATABASE_URL_DIRECT=postgresql://migrator-role:REPLACE_ME@ep-xxx.region.aws.neon.tech/nokmel_website?sslmode=require
# Operator-only published-content transfer (`pnpm content:transfer`). Direct
# endpoints only; never configure these in Vercel or commit real values.
CONTENT_TRANSFER_SOURCE_URL=
CONTENT_TRANSFER_TARGET_URL=
