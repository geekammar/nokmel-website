# Nokmel Website — environment contract (placeholders only; never commit real values)
#
# Application runtime (server-only, Vercel "Production"/"Preview" env vars):
DATABASE_URL=postgresql://pooled-app-role:REPLACE_ME@ep-xxx-pooler.region.aws.neon.tech/nokmel_website?sslmode=require
BETTER_AUTH_SECRET=REPLACE_ME_MIN_32_RANDOM_CHARS
BETTER_AUTH_URL=https://nokmel.tech
TRUSTED_ORIGINS=https://nokmel.tech
OWNER_EMAIL=owner@REPLACE_ME.example
# Optional override for the sign-in rate limit ceiling (integer; default 5/min).
# Reason documented in docs/ARCHITECTURE.md — used only to raise the ceiling in
# disposable automated e2e environments, never to disable protection.
RATE_LIMIT_SIGNIN_MAX=
# Migration/operator-only (never exposed to the runtime role):
DATABASE_URL_DIRECT=postgresql://migrate-role:REPLACE_ME@ep-xxx.region.aws.neon.tech/nokmel_website?sslmode=require
